DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-value-before-deploying"
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins in production. In development
# any origin is allowed so Expo's dev tunnels/simulators just work.
CORS_ORIGINS=""

# Set to a phone number to bypass OTP delivery and log the code to the server
# console instead of sending an SMS — there is no SMS provider wired up yet.
# NEVER enable this in production.
OTP_DEV_MODE=true
