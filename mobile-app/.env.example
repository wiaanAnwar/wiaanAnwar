# Points the app at the BV Fleet backend (see /backend).
# - iOS simulator: http://localhost:4000 (default) works as-is.
# - Android emulator: use http://10.0.2.2:4000 instead of localhost.
# - Physical device: use your machine's LAN IP, e.g. http://192.168.1.20:4000.
EXPO_PUBLIC_API_URL=http://localhost:4000
